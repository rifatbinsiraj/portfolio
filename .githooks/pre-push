#!/usr/bin/env bash
# Pushing is the deploy, so the Drive copies of the CVs are refreshed alongside it,
# but only when the pushed commits actually change one of the PDFs.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
SYNC="$ROOT/scripts/sync-cv-to-drive.sh"
PDFS=(Rifat_Bin_Siraj_CV.pdf Rifat_Bin_Siraj_CV_ATS.pdf)
ZERO=0000000000000000000000000000000000000000

[[ -x "$SYNC" ]] || exit 0

changed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue
  if [[ "$remote_sha" == "$ZERO" ]] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    changed=1
    break
  fi
  if [[ -n "$(git diff --name-only "$remote_sha" "$local_sha" -- "${PDFS[@]}")" ]]; then
    changed=1
    break
  fi
done

if [[ "$changed" -eq 0 ]]; then
  echo "pre-push: CVs unchanged in this push, leaving Drive alone."
  exit 0
fi

"$SYNC" || echo "pre-push: Drive CV sync failed, push continuing." >&2
